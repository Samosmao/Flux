; FluxIdd -- Windows 11 ARM64 UMDF IddCx package. Not installed by this milestone.
[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4D36E968-E325-11CE-BFC1-08002BE10318}
Provider=%Flux%
CatalogFile=FluxIdd.cat
DriverVer=09/28/2026,0.1.0.0
PnpLockDown=1
[Manufacturer]
%Flux%=FluxModels,NTarm64
[FluxModels.NTarm64]
%FluxIdd.DeviceDesc%=FluxIdd_Install,ROOT\FLUX_IDD
[SourceDisksNames]
1=%DiskName%,,,
[SourceDisksFiles]
FluxIdd.dll=1
[DestinationDirs]
FluxIdd_CopyFiles=12,UMDF
[FluxIdd_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=FluxIdd_CopyFiles
[FluxIdd_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=FluxIdd_HardwareSettings
[FluxIdd_HardwareSettings]
HKR,,UpperFilters,0x00010000,"IndirectKmd"
HKR,WUDF,DeviceGroupId,0x00000000,"FluxIddDeviceGroup"
[FluxIdd_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services
[FluxIdd_Install.NT.Wdf]
UmdfService=FluxIdd,FluxIdd_UmdfService
UmdfServiceOrder=FluxIdd
UmdfKernelModeClientPolicy=AllowKernelModeClients
[FluxIdd_UmdfService]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\FluxIdd.dll
UmdfExtensions=IddCx0102
[FluxIdd_CopyFiles]
FluxIdd.dll
[Strings]
Flux="Flux"
DiskName="Flux IddCx Installation Disk"
FluxIdd.DeviceDesc="Flux Virtual Display Adapter"
